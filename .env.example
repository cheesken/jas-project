# All defaults. Copy to .env and edit if needed.
REDIS_URL=redis://redis:6379/0
CHROMA_PATH=/data/chroma
SQLITE_PATH=/data/personal_memory.db
OLLAMA_URL=http://host.docker.internal:11434
OLLAMA_MODEL=llama3:8b
EMBEDDING_MODEL=all-MiniLM-L6-v2

# Comma-separated directories for the file watcher to monitor.
# Example: WATCH_DIRS=/Users/jane/Documents,/Users/jane/Desktop
WATCH_DIRS=

# spaCy model for entity extraction. en_core_web_lg is more accurate (F1 0.88 vs 0.83
# on tests/fixtures/ner_eval.jsonl) but adds ~560 MB to the image and RAM per worker;
# install its wheel in backend/Dockerfile before switching.
NER_MODEL=en_core_web_sm
